# ════════════════════════════════════════════════════════════════════════════
# EXEMPLO DE CONFIGURAÇÃO — copie para ".env" e preencha com seus valores reais.
# Este arquivo PODE ser commitado (não contém segredos).
# Em produção (Render/Railway), cadastre as mesmas chaves como variáveis
# de ambiente no painel da hospedagem — NÃO suba o .env real.
# ════════════════════════════════════════════════════════════════════════════

# Porta do servidor. Em produção a hospedagem injeta a PORT automaticamente.
PORT=3000

# ── Supabase ──────────────────────────────────────────────────────────────────
# Painel: https://app.supabase.com → seu projeto → Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# service_role: SEGREDO. Acesso total. Use SÓ no servidor, nunca no navegador.
SUPABASE_SERVICE_KEY=COLOQUE_SEU_VALOR
# anon: pública por design (protegida por RLS). Usada na tela de login.
SUPABASE_ANON_KEY=COLOQUE_SEU_VALOR
# JWT Secret do projeto (Settings → API → JWT Settings). SEGREDO.
SUPABASE_JWT_SECRET=COLOQUE_SEU_VALOR
# Tabela onde ficam as anotações do analista.
SUPABASE_TABLE=anotacoes_analista

# ── Google Sheets ─────────────────────────────────────────────────────────────
# URL da planilha (ALICE). Precisa estar acessível para leitura.
SHEETS_URL=https://docs.google.com/spreadsheets/d/SEU_ID/edit
# 0 = sem auto-refresh; >0 = intervalo em segundos.
SHEETS_AUTO_REFRESH_SEG=0
# TTL do cache em segundos (0 = nunca expira sozinho).
SHEETS_CACHE_TTL_SEG=60
# Quantas versões da planilha manter em disco.
SHEETS_KEEP_VERSIONS=20

# ── Autenticação local (alternativa ao Supabase Auth — geralmente vazio) ──────
# Lista "usuario:senha" separada por vírgula. Deixe vazio se usar Supabase Auth.
API_USERS=
# Segredo para assinar tokens locais (HMAC). Vazio se usar Supabase Auth.
API_SECRET=
# 'true' exige token também para leituras (GET). Padrão: só escritas.
AUTH_PROTEGE_LEITURA=false
# Validade do token de sessão local, em segundos (28800 = 8h).
AUTH_TOKEN_TTL_SEG=28800

# ── Relatórios ────────────────────────────────────────────────────────────────
# Nome do bucket no Supabase Storage onde os PDFs são guardados.
RELATORIOS_BUCKET=relatorios

# ── Puppeteer (geração de PDF) ────────────────────────────────────────────────
# Em produção via Docker, apontamos para o Chromium do sistema. Localmente
# deixe vazio para usar o Chromium que o pacote "puppeteer" baixa sozinho.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
